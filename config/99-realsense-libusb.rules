# D435/D435i subset of librealsense v2.44.0's official Linux udev rules.
# Upstream: https://github.com/IntelRealSense/librealsense/blob/v2.44.0/config/99-realsense-libusb.rules
# librealsense is licensed under Apache-2.0.

# Intel RealSense D435 (USB product 0b07) and D435i (USB product 0b3a).
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b07", MODE:="0666", GROUP:="plugdev"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", MODE:="0666", GROUP:="plugdev"

# D435i motion-module nodes. The classic Open3D reconstruction path does not
# consume IMU samples, but keeping the official permissions avoids blocking
# librealsense device discovery and permits separate IMU tooling.
KERNEL=="iio*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", MODE:="0777", GROUP:="plugdev", RUN+="/bin/sh -c 'chmod -R 0777 /sys/%p'"
DRIVER=="hid_sensor*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", RUN+="/bin/sh -c 'chmod -R 0777 /sys/%p && chmod 0777 /dev/%k'"
